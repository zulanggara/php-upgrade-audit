{
    "name": "php-upgrade-audit/tools",
    "description": "Analysis tools for php-upgrade-audit. Installed here by scripts/setup.sh, never into an audited repo.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "require": {
        "composer/semver": "^3.4",
        "rector/rector": "^2.7",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0",
        "phpcompatibility/php-compatibility": "^10.0@alpha"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
